{
  "name": "dsh-opencode",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "OpenCode provider for DeepSeek Harness 0.2.2: one plugin-owned LLM provider with a Models-page import dialog that reads the live OpenCode catalogue, prefills each model's interface and context window, dispatches mixed wire protocols (OpenAI Chat Completions, OpenAI Responses, Anthropic Messages, Google Generative AI) while routing each conversation by its session, and forwards attached images to image-capable models.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-opencode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-opencode/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-zen",
    "model-import",
    "cordis"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "1.3.0"
  }
}
